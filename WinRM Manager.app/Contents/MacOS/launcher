#!/bin/bash
# WinRM Manager 启动器
# 职责：确保本地服务已运行，然后打开浏览器界面

APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
PORT=5178
URL="http://127.0.0.1:${PORT}"
LOG_DIR="$HOME/.winrm-manager"
LOG="$LOG_DIR/server.log"
mkdir -p "$LOG_DIR"

notify() {
  osascript -e "display alert \"WinRM Manager\" message \"$1\"" >/dev/null 2>&1
}

is_up() {
  curl -s --noproxy '*' -m 2 -o /dev/null "${URL}/api/health" 2>/dev/null
}

# 已经在跑：直接打开界面
if is_up; then
  open "$URL"
  exit 0
fi

# 找一个装了 winrm + flask 的解释器
PY=""
for c in \
  "/Users/peter/.workbuddy-ai/binaries/python/versions/3.13.12/bin/python3" \
  "$(command -v python3)" \
  "/opt/homebrew/bin/python3" \
  "/usr/local/bin/python3" \
  "/usr/bin/python3"
do
  if [ -n "$c" ] && [ -x "$c" ] && "$c" -c "import winrm, flask" >/dev/null 2>&1; then
    PY="$c"
    break
  fi
done

if [ -z "$PY" ]; then
  notify "未找到装有 pywinrm 与 flask 的 Python 3 环境。请在终端执行：pip3 install pywinrm requests-ntlm flask"
  exit 1
fi

cd "$APP_DIR" || { notify "找不到应用目录：$APP_DIR"; exit 1; }

# 清掉 shell 里的代理变量，内网直连
unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy ALL_PROXY all_proxy
export NO_PROXY="*"

nohup "$PY" server.py --no-browser --port "$PORT" >> "$LOG" 2>&1 &
echo "--- $(date '+%Y-%m-%d %H:%M:%S') 启动 PID $! ---" >> "$LOG"

for _ in $(seq 1 60); do
  if is_up; then
    open "$URL"
    exit 0
  fi
  sleep 0.3
done

notify "服务启动超时，请查看日志：$LOG"
exit 1
